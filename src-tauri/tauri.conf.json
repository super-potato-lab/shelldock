{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ShellDock",
  "version": "0.1.0",
  "identifier": "io.github.super-potato-lab.shelldock",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "ShellDock", "width": 1360, "height": 900, "minWidth": 960, "minHeight": 660 }],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": { "active": true, "targets": ["nsis", "dmg", "deb"], "icon": ["icons/icon.png", "icons/icon.ico", "icons/icon.icns"] }
}
